server {
  listen 443 ssl;
  http2 on; # Replaces old 'listen 443 ssl http2' which throws deprecation warning
  server_name data-registry.wehi-rcp.cloud.edu.au;

  ssl_certificate /var/lib/https-portal/data-registry.wehi-rcp.cloud.edu.au/production/chained.crt;
  ssl_certificate_key /var/lib/https-portal/data-registry.wehi-rcp.cloud.edu.au/production/domain.key;
  
  location /fastapi/ {
    proxy_pass http://backend:8888/;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }
  
  location / {
    root /var/www/vhosts/data-registry;
    index index.html;
    try_files $uri $uri/ /index.html;
  }
}
